# Local build configuration for scripts/legacy/build-ios.sh
# From the repo root, copy this tracked example to the ignored private file:
# cp scripts/legacy/build-ios.private.env.example build-ios.private.env
# Edit only the root build-ios.private.env for private values, not this example.

# The script builds both an unsigned IPA and a signed IPA.
# The signed IPA uses App Store export by default.
# IOS_EXPORT_METHOD="app-store"

# For a signed build for your own registered devices, use development export.
# IOS_EXPORT_METHOD="development"

# Or use a custom export options plist file (instead of --export-method).
# Can be an absolute path or relative to the repo root.
# IOS_EXPORT_OPTIONS_PLIST="ios/ExportOptions-development.plist"

# If Flutter isn't on your PATH, point to it here.
# FLUTTER_BIN="$HOME/flutter/bin/flutter"