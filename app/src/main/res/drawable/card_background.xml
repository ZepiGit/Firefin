<?xml version="1.0" encoding="utf-8"?>
<!-- Card focus: accent stroke plus a lighter surface, drawn once as a static background; no scale or animation. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/surface_focus"/><stroke android:width="@dimen/focus_stroke" android:color="@color/accent"/><corners android:radius="@dimen/corner_radius"/></shape></item>
    <item><shape><solid android:color="@color/surface"/><corners android:radius="@dimen/corner_radius"/></shape></item>
</selector>
