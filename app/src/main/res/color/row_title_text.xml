<?xml version="1.0" encoding="utf-8"?>
<!-- A focused row title sits on the accent fill, so its text flips to on_accent like a focused button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/on_accent"/>
    <item android:color="@color/text_primary"/>
</selector>
