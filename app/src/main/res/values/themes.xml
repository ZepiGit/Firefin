<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Firefin" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textViewStyle">@style/Firefin.Text</item>
        <item name="buttonStyle">@style/Firefin.Button</item>
        <item name="android:buttonStyle">@style/Firefin.Button</item>
        <item name="editTextStyle">@style/Firefin.Input</item>
        <item name="android:editTextStyle">@style/Firefin.Input</item>
        <item name="alertDialogTheme">@style/Firefin.Dialog</item>
        <item name="android:alertDialogTheme">@style/Firefin.Dialog</item>
    </style>

    <style name="Theme.Firefin.Player" parent="Theme.Firefin">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Firefin.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/surface</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="buttonBarButtonStyle">@style/Firefin.Button.Dialog</item>
        <item name="android:buttonBarButtonStyle">@style/Firefin.Button.Dialog</item>
        <item name="listPreferredItemHeightSmall">@dimen/control_height</item>
        <item name="android:listPreferredItemHeightSmall">@dimen/control_height</item>
        <item name="alertDialogStyle">@style/Firefin.AlertDialog</item>
    </style>
    <!-- Own list rows: the stock rows rely on the list selector, which stays invisible on the dialog list. -->
    <style name="Firefin.AlertDialog" parent="AlertDialog.AppCompat">
        <item name="listItemLayout">@layout/item_dialog_choice</item>
        <item name="singleChoiceItemLayout">@layout/item_dialog_single_choice</item>
        <item name="multiChoiceItemLayout">@layout/item_dialog_multi_choice</item>
    </style>

    <!-- Root of the dotted style names; carries nothing itself. -->
    <style name="Firefin" />

    <!-- Text -->
    <style name="Firefin.Text" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
    <style name="Firefin.Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Firefin.Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Firefin.Text.Heading">
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Firefin.Text.Subheading">
        <item name="android:textSize">@dimen/text_subheading</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Firefin.Text.Body">
        <item name="android:lineSpacingExtra">@dimen/space_xs</item>
    </style>
    <style name="Firefin.Text.Label">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Firefin.Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Firefin.Text.Accent">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <!-- Row titles can be focusable (library link); the focus state uses the same stroke as cards. -->
    <style name="Firefin.Text.RowTitle" parent="Firefin.Text.Subheading">
        <item name="android:background">@drawable/row_title_background</item>
        <item name="android:textColor">@color/row_title_text</item>
        <item name="android:paddingLeft">@dimen/space_s</item>
        <item name="android:paddingRight">@dimen/space_s</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
    </style>

    <!-- Controls -->
    <style name="Firefin.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:minWidth">@dimen/control_height</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:paddingLeft">@dimen/space_l</item>
        <item name="android:paddingRight">@dimen/space_l</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <!-- Settings rows: a wide, left-aligned button showing "Label: value". -->
    <style name="Firefin.Button.Setting">
        <item name="android:layout_width">480dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_s</item>
        <item name="android:gravity">center_vertical|left</item>
    </style>
    <style name="Firefin.Button.Dialog" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dialog_button_text</item>
        <item name="android:background">@drawable/dialog_button_background</item>
    </style>
    <!-- Square icon button in the Home toolbar; the pill background becomes a circle. -->
    <style name="Firefin.IconButton">
        <item name="android:layout_width">@dimen/control_height</item>
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:focusable">true</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/button_text</item>
    </style>
    <style name="Firefin.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/input_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingLeft">@dimen/space_m</item>
        <item name="android:paddingRight">@dimen/space_m</item>
        <item name="android:singleLine">true</item>
    </style>
    <!-- Page header: title on the left, actions on the right, overscan-safe margins; the top padding keeps controls below the 5 % overscan band. -->
    <style name="Firefin.Header">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/header_height</item>
        <item name="android:paddingTop">@dimen/space_l</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">@dimen/page_margin</item>
        <item name="android:paddingRight">@dimen/page_margin</item>
    </style>
</resources>
