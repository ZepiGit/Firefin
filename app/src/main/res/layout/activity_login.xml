<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginBottom="@dimen/space_m"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/firefin_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_s"
                android:fontFamily="sans-serif-black"
                android:text="@string/app_name"
                android:textColor="@color/wordmark"
                android:textSize="@dimen/text_display" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <TextView
                android:id="@+id/title"
                style="@style/Firefin.Text.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m"
                android:text="@string/login_title" />

            <TextView
                style="@style/Firefin.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:labelFor="@+id/serverUrl"
                android:text="@string/server_url_label" />

            <EditText
                android:id="@id/serverUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:nextFocusDown="@id/username"
                android:nextFocusForward="@id/username" />

            <TextView
                style="@style/Firefin.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_xs"
                android:labelFor="@+id/username"
                android:text="@string/username_label" />

            <EditText
                android:id="@id/username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:nextFocusUp="@id/serverUrl"
                android:nextFocusDown="@id/password"
                android:nextFocusForward="@id/password" />

            <TextView
                style="@style/Firefin.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_xs"
                android:labelFor="@+id/password"
                android:text="@string/password_label" />

            <EditText
                android:id="@id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:nextFocusUp="@id/username"
                android:nextFocusDown="@id/loginButton"
                android:nextFocusForward="@id/loginButton"
                android:saveEnabled="false" />

            <Button
                android:id="@+id/loginButton"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:nextFocusUp="@id/password"
                android:text="@string/login_button" />

            <Button
                android:id="@+id/quickConnectButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:nextFocusUp="@id/loginButton"
                android:text="@string/quick_connect_button" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="@dimen/space_s"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error"
                style="@style/Firefin.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/error"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
