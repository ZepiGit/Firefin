<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/page_margin"
        android:paddingRight="@dimen/page_margin">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="@dimen/space_m"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/firefin_mark" />

        <ImageButton
            android:id="@+id/homeButton"
            style="@style/Firefin.IconButton"
            android:contentDescription="@string/home"
            android:nextFocusLeft="@id/homeButton"
            android:nextFocusRight="@id/searchButton"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/searchButton"
            style="@style/Firefin.IconButton"
            android:layout_marginLeft="@dimen/space_s"
            android:contentDescription="@string/search"
            android:nextFocusLeft="@id/homeButton"
            android:nextFocusRight="@id/libraryButton"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/libraryButton"
            style="@style/Firefin.IconButton"
            android:layout_marginLeft="@dimen/space_s"
            android:contentDescription="@string/libraries"
            android:nextFocusLeft="@id/searchButton"
            android:nextFocusRight="@id/mediaRequestsButton"
            android:src="@drawable/ic_library" />

        <ImageButton
            android:id="@+id/mediaRequestsButton"
            style="@style/Firefin.IconButton"
            android:layout_marginLeft="@dimen/space_s"
            android:contentDescription="@string/media_requests"
            android:nextFocusLeft="@id/libraryButton"
            android:nextFocusRight="@id/randomButton"
            android:src="@drawable/ic_requests" />

        <ImageButton
            android:id="@+id/randomButton"
            style="@style/Firefin.IconButton"
            android:layout_marginLeft="@dimen/space_s"
            android:contentDescription="@string/random_playback"
            android:nextFocusLeft="@id/mediaRequestsButton"
            android:nextFocusRight="@id/favoritesButton"
            android:src="@drawable/ic_shuffle" />

        <ImageButton
            android:id="@+id/favoritesButton"
            style="@style/Firefin.IconButton"
            android:layout_marginLeft="@dimen/space_s"
            android:contentDescription="@string/favorites"
            android:nextFocusLeft="@id/randomButton"
            android:nextFocusRight="@id/settingsButton"
            android:src="@drawable/ic_star" />

        <ImageButton
            android:id="@+id/settingsButton"
            style="@style/Firefin.IconButton"
            android:layout_marginLeft="@dimen/space_s"
            android:contentDescription="@string/settings"
            android:nextFocusLeft="@id/favoritesButton"
            android:nextFocusRight="@id/settingsButton"
            android:src="@drawable/ic_settings" />

        <TextView
            android:id="@+id/toolbarActionLabel"
            style="@style/Firefin.Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_m"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="right"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:visibility="invisible" />

        <TextClock
            style="@style/Firefin.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_m"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/preview_height">

        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/backdrop_scrim" />

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="@dimen/page_margin"
            android:paddingRight="@dimen/space_l">

            <TextView
                android:id="@+id/previewName"
                style="@style/Firefin.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_preview_default" />

            <TextView
                android:id="@+id/previewMeta"
                style="@style/Firefin.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <TextView
                android:id="@+id/previewOverview"
                style="@style/Firefin.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:ellipsize="end"
                android:maxLines="3"
                android:textSize="@dimen/text_label" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_l" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <include layout="@layout/view_state" />
    </FrameLayout>
</LinearLayout>
