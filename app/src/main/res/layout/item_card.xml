<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="@dimen/card_poster_width"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/card_gap"
    android:background="@drawable/card_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_poster_image_height">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/outline"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/progress"
            android:layout_width="0dp"
            android:layout_height="@dimen/card_progress_height"
            android:layout_gravity="bottom|left"
            android:background="@color/accent"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        style="@style/Firefin.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:ellipsize="end"
        android:maxLines="2"
        android:minLines="2"
        android:paddingLeft="@dimen/space_xs"
        android:paddingRight="@dimen/space_xs"
        android:textSize="@dimen/text_card" />

    <TextView
        android:id="@+id/subtitle"
        style="@style/Firefin.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingLeft="@dimen/space_xs"
        android:paddingRight="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs"
        android:singleLine="true" />
</LinearLayout>
