<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/page_margin"
        android:paddingTop="@dimen/space_xl"
        android:paddingRight="@dimen/page_margin"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            style="@style/Firefin.Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings" />

        <TextView
            android:id="@+id/accountInfo"
            style="@style/Firefin.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" />

        <TextView
            style="@style/Firefin.Text.Subheading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/section_playback" />

        <Button
            android:id="@+id/qualityButton"
            style="@style/Firefin.Button.Setting"
            android:layout_marginTop="@dimen/space_s" />

        <Button
            android:id="@+id/audioLanguageButton"
            style="@style/Firefin.Button.Setting" />

        <Button
            android:id="@+id/subtitleLanguageButton"
            style="@style/Firefin.Button.Setting" />

        <Button
            android:id="@+id/subtitleSizeButton"
            style="@style/Firefin.Button.Setting" />

        <TextView
            style="@style/Firefin.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_size_hint" />

        <TextView
            style="@style/Firefin.Text.Subheading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/section_interface" />

        <Button
            android:id="@+id/backdropsButton"
            style="@style/Firefin.Button.Setting"
            android:layout_marginTop="@dimen/space_s" />

        <Button
            android:id="@+id/homeOrderButton"
            style="@style/Firefin.Button.Setting" />

        <Button
            android:id="@+id/clearCacheButton"
            style="@style/Firefin.Button.Setting"
            android:text="@string/clear_image_cache" />

        <TextView
            style="@style/Firefin.Text.Subheading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/section_account" />

        <Button
            android:id="@+id/remoteButton"
            style="@style/Firefin.Button.Setting"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/remote_control" />

        <Button
            android:id="@+id/logoutButton"
            style="@style/Firefin.Button.Setting"
            android:text="@string/logout" />

        <TextView
            style="@style/Firefin.Text.Subheading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/about" />

        <TextView
            android:id="@+id/aboutText"
            style="@style/Firefin.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:maxWidth="720dp" />

        <Button
            android:id="@+id/developerGithubButton"
            style="@style/Firefin.Button.Setting"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/developer_github" />
    </LinearLayout>
</ScrollView>
