<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/backdrop_scrim" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/page_margin"
            android:paddingTop="@dimen/page_margin"
            android:paddingRight="@dimen/page_margin"
            android:paddingBottom="@dimen/space_m">

            <TextView
                android:id="@+id/contextLabel"
                style="@style/Firefin.Text.Accent"
                android:layout_width="720dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_s"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/name"
                style="@style/Firefin.Text.Display"
                android:layout_width="720dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2" />

            <TextView
                android:id="@+id/meta"
                style="@style/Firefin.Text.Label"
                android:layout_width="720dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />

            <TextView
                android:id="@+id/overview"
                style="@style/Firefin.Text.Body"
                android:layout_width="720dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:ellipsize="end"
                android:maxLines="4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/playButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/play_with_icon" />

                <Button
                    android:id="@+id/restartButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_s"
                    android:text="@string/restart"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/favoriteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_s"
                    android:text="@string/favorite" />

                <Button
                    android:id="@+id/watchedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_s"
                    android:text="@string/mark_watched" />

                <Button
                    android:id="@+id/retryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_s"
                    android:text="@string/reload"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/childrenTitle"
                style="@style/Firefin.Text.Subheading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m" />

            <zepigit.firefin.app.ui.TvRecyclerView
                android:id="@+id/children"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-8dp"
                android:layout_marginTop="@dimen/space_xs"
                android:clipToPadding="false" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
